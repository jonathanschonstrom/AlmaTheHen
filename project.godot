config_version=5

[application]
config/name="BirdAI · Alma v0.5.7 · NeuralBrain v0.2.6 control"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/description="Autonom fågel med embodied physiology och NeuralBrain v0.2.6 som faktisk handlingsfamilj-controller. Utility körs endast som diagnostisk referens i control-läge. BG100, valuation, commitment och NeuralBrain-matematik är oförändrade från v0.5.6."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver.windows="d3d12"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.07, 0.095, 0.1, 1)

[audio]
driver/enable_input=false

[debug]
gdscript/warnings/untyped_declaration=0
